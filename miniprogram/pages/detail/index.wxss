/* 作业详情页面样式 */

.center-loading {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
}

.detail-header {
  margin-bottom: 16rpx;
}

.course-tag {
  font-size: 26rpx;
  color: #fff;
  background: var(--primary);
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
}

.deadline-badge {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.deadline-badge.ddl-safe {
  color: var(--success);
  background: #E8F8F0;
}

.deadline-badge.ddl-warning {
  color: var(--warning);
  background: #FEF3E2;
}

.deadline-badge.ddl-danger,
.deadline-badge.ddl-expired {
  color: var(--danger);
  background: #FDEDEC;
}

.detail-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.detail-content {
  margin-bottom: 20rpx;
}

.content-text {
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.content-text:not(:last-child) {
  margin-bottom: 20rpx;
}

/* 图片网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.content-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  background: var(--border);
}

/* 元信息 */
.detail-meta {
  margin-bottom: 40rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
}

.meta-row + .meta-row {
  border-top: 1rpx solid var(--border);
}

.meta-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.meta-value {
  font-size: 26rpx;
  color: var(--text-primary);
  max-width: 60%;
  text-align: right;
  word-break: break-all;
}

/* 操作区 */
.detail-actions {
  padding: 0 10rpx;
}

.synced-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 0;
}

.synced-hint {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.report-link {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-hint);
  padding: 30rpx 0;
}

.dialog-body {
  padding: 30rpx;
}
