/* 作业墙页面样式 */

.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0 16rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* 课程筛选标签 */
.filter-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
  padding: 4rpx 0;
}

.filter-tags {
  display: inline-flex;
  gap: 16rpx;
}

.filter-tag {
  display: inline-block;
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--bg-card);
  border-radius: 32rpx;
  border: 2rpx solid var(--border);
  transition: all 0.2s;
}

.filter-tag--active {
  color: #fff;
  background: var(--primary);
  border-color: var(--primary);
}

.assignment-list {
  padding-bottom: 40rpx;
}

.loading-tip,
.end-tip {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: var(--text-hint);
}

.loading-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}
