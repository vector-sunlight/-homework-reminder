/* 个人中心页面样式 */

/* 用户信息卡片 */
.profile-card {
  display: flex;
  align-items: center;
  padding: 36rpx 30rpx;
  margin-bottom: 20rpx;
}

.profile-avatar {
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--border);
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.profile-class {
  font-size: 26rpx;
  color: var(--primary);
}

.profile-no-class {
  font-size: 26rpx;
  color: var(--text-hint);
}

/* 统计卡片 */
.stats-card {
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.stats-row {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: var(--border);
}

/* 分组 */
.section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 24rpx;
  color: var(--text-hint);
  padding: 0 0 12rpx 10rpx;
}

/* 弹窗内容 */
.dialog-body {
  padding: 30rpx;
}
